generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Active {
  Y
  N
}

model User {
  id        Int       @id @default(autoincrement())
  loginId   String    @unique
  password  String
  nickname  String?
  email     String
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime? @db.Timestamp(0)

  @@map("users")
}

model Product {
  id       Int      @id @default(autoincrement())
  name     String?
  originalPrice Int @default(0)
  price    Int      @default(0)
  quantity Int      @default(0)
  active   Active   @default(N)
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime? @db.Timestamp(0)
  productthumbnailImages ProductThumbnailImages[]
  productDetailImages ProductDetailImages[]
  categoryProducts CategoryProduct[]
  productColorOptions ProductColorOption[]
  @@map("products")
}


model ProductThumbnailImages {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())
  productId Int
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  original String @db.Text
  webp     String @db.Text
  jpeg     String @db.Text
  originalBucket   String
  webpBucket   String
  jpegBucket   String
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  @@map("productThumbnailImages")
}

model ProductDetailImages {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())
  productId Int
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  original String @db.Text
  webp     String @db.Text
  jpeg     String @db.Text
  originalBucket   String
  webpBucket   String
  jpegBucket   String
createdAt DateTime  @default(now()) @db.Timestamp(0)
  @@map("productDetailImages")
}

model Category {
  id Int @id @default(autoincrement())
  name String @unique
  active Active @default(N)
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime? @db.Timestamp(0)
  categoryProducts CategoryProduct[]
  @@map("categories")
}

model CategoryProduct {
  category Category @relation(fields: [categoryId], references: [id],onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId Int
  productId Int
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  @@id([categoryId, productId])

  @@map("categoryProducts")
}

model ColorOption {
  id Int @id @default(autoincrement())
  name String @unique
  active Active @default(N)
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime? @db.Timestamp(0)
  productColorOptions ProductColorOption[]
  @@map("colorOptions")
}

model ProductColorOption {
  product Product @relation(fields: [productId], references: [id])
  colorOption ColorOption @relation(fields: [colorOptionId], references: [id], onDelete: Cascade)
  productId Int
  colorOptionId Int
  createdAt DateTime  @default(now()) @db.Timestamp(0)
   @@id([productId, colorOptionId])
  @@map("productColorOptions")
}

